<!--
  FR3 pHRI Scene — generated by simulation/setup_model.py
  Placed inside franka_fr3/ so that meshdir="assets" in fr3.xml
  resolves to franka_fr3/assets/ correctly.
-->
<mujoco model="fr3_phri_scene">
  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <include file="scene.xml"/>

  <worldbody>
    <!-- Desired EE target marker (green sphere) -->
    <site name="target_pos"   pos="0.4 0.0 0.5"  size="0.025"
          rgba="0 1 0 0.5" type="sphere"/>
    <!-- Human wrist position marker (red sphere) -->
    <site name="human_wrist"  pos="0.1 0.3 0.4"  size="0.025"
          rgba="1 0 0 0.5" type="sphere"/>
    <!-- Contact-detected indicator (yellow; toggled by Python) -->
    <site name="contact_flag" pos="0.4 0.0 0.7"  size="0.015"
          rgba="1 1 0 0.0" type="sphere"/>
  </worldbody>

  <sensor>
    <!-- Joint positions (rad) -->
    <jointpos name="q1" joint="fr3_joint1"/>
    <jointpos name="q2" joint="fr3_joint2"/>
    <jointpos name="q3" joint="fr3_joint3"/>
    <jointpos name="q4" joint="fr3_joint4"/>
    <jointpos name="q5" joint="fr3_joint5"/>
    <jointpos name="q6" joint="fr3_joint6"/>
    <jointpos name="q7" joint="fr3_joint7"/>

    <!-- Joint velocities (rad/s) -->
    <jointvel name="dq1" joint="fr3_joint1"/>
    <jointvel name="dq2" joint="fr3_joint2"/>
    <jointvel name="dq3" joint="fr3_joint3"/>
    <jointvel name="dq4" joint="fr3_joint4"/>
    <jointvel name="dq5" joint="fr3_joint5"/>
    <jointvel name="dq6" joint="fr3_joint6"/>
    <jointvel name="dq7" joint="fr3_joint7"/>

    <!-- Applied joint torques (Nm) — reads qfrc_applied via actuatorfrc -->
    <actuatorfrc name="tau1" actuator="fr3_joint1"/>
    <actuatorfrc name="tau2" actuator="fr3_joint2"/>
    <actuatorfrc name="tau3" actuator="fr3_joint3"/>
    <actuatorfrc name="tau4" actuator="fr3_joint4"/>
    <actuatorfrc name="tau5" actuator="fr3_joint5"/>
    <actuatorfrc name="tau6" actuator="fr3_joint6"/>
    <actuatorfrc name="tau7" actuator="fr3_joint7"/>

    <!-- End-effector Cartesian position (m) -->
    <framepos  name="ee_pos" objtype="site" objname="attachment_site"/>

    <!-- End-effector linear velocity (m/s) -->
    <framelinvel name="ee_vel" objtype="site" objname="attachment_site"/>

    <!-- External force at EE (N) — from contact/applied wrenches -->
    <force name="ee_force" site="attachment_site"/>
  </sensor>
</mujoco>
